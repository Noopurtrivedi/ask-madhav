# ─── Ask Madhav — environment variables ───────────────────────────────
# Everything below is OPTIONAL. With none of these set, the app runs fully
# on Vercel's free tier using the deterministic keyword verse engine.

# Madhav Dialogue (AI) — Google Gemini free tier.
# Get a free key at https://aistudio.google.com/apikey
# When set, Madhav gives multi-turn, context-aware guidance grounded in the
# retrieved verses (RAG). When unset, it falls back to the template engine.
GEMINI_API_KEY=

# Sankalpa Journal — Supabase (auth + saved verses + journaling + streaks).
# Free tier at https://supabase.com. When unset, journal features are hidden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (server-only) — used by the Daily Ritual cron + subscribe API.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Daily Ritual email delivery — Resend free tier (https://resend.com).
# When unset, email subscription is disabled (web push still works).
RESEND_API_KEY=
DAILY_RITUAL_FROM_EMAIL=
# Secret guarding the cron endpoint that sends the daily verse.
CRON_SECRET=

# Rate limiting for /api/ask — Upstash Redis free tier (no credit card).
# Optional: without these, a best-effort in-memory limiter is used instead.
# Create a free DB at https://console.upstash.com and copy the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL, used for share links and OG image absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy: point at a standalone backend instead of the built-in API routes.
# Leave blank to use the bundled Next.js verse engine (recommended).
NEXT_PUBLIC_API_URL=
